#in.Tensile_test_CuAlNiFe:

################################START###########################################

# Input file for uniaxial tensile test of single fcc CuAlNiFe crystal

variable T equal 300

# ---------- Initialize Simulation ---------------------
clear
units metal                       ## use metal unit system - see lammps manual
boundary p p p                    ## make simulation box periodic along all directions
atom_style full                ## default atom style for metals


read_data Cu_poly_20

# ---------- Define Interatomic Potential ---------------------
pair_style meam                  ## set interatomic potential style to be MEAM
pair_coeff * *  library.meam Al Co Cu Cr Fe Mn Ni Ti FeMnNiTiCuCrCoAl.meam Cu Al Fe Ni 
neighbor    0.3 bin                ## define parameters for neighbor list
neigh_modify    delay 20              ## define parameters for neighbor list

# ---------- Define Settings -------------------------
compute csym all centro/atom fcc
compute peratom all pe/atom

# ---------- Run Minimization ---------------------
reset_timestep 0                                        ## reset timestep
thermo 100                                               ## set thermo-properties output on screen every 100 timestep
thermo_style custom step temp pe lx ly lz press pxx pyy pzz## timestep(step), potential energy(pe), box dimension (Lx/Ly/Lz),pressure(press) etc. output on screen
min_style cg                                            ## minimization (using CG method)
minimize 1e-25 1e-25 5000 10000                         ## minimization parameter setup, see manual for more detail

#############Minimization Finish--------------------

# ---------- EQUILIBRATION -------------------------
reset_timestep    0
timestep 0.001
                                        ## set timestep 0.001 ps
velocity all create 300 765896 mom yes rot no
fix 1 all npt temp 300 $T 1 iso 0 0 1 drag 1

### Run for 30 picosecond, timestep is 0.001ps
run 60000
unfix 1

### Store final cell length for strain calculations
variable tmp equal "lx"
variable L0 equal ${tmp}
print "Initial Length, L0: ${L0}"

######################################
# DEFORMATION
reset_timestep    0

fix        1 all npt temp $T $T 0.01 y 0 0 1 z 0 0 1 drag 1
variable srate equal 1.0e10
variable srate1 equal "v_srate / 1.0e12"
fix        2 all deform 1 x erate ${srate1} units box remap x

# Output strain and stress info to file
# for units metal, pressure is in [bars] = 100 [kPa] = 1/10000 [GPa]
# p2, p3, p4 are in GPa
variable strain equal "(lx - v_L0)/v_L0"
variable p1 equal "v_strain"
variable p2 equal "-pxx/10000"
variable p3 equal "-pyy/10000"
variable p4 equal "-pzz/10000"
fix def1 all print 100 "${p1} ${p2} ${p3} ${p4}" file CuAlNiFe_poly_10_300.def1.txt screen no

# Use dump.tensile.atom file for Ovito visualization
dump         1 all custom 250 dump.tensile.atom id type xs ys zs c_csym c_peratom fx fy fz

# Display thermo
thermo     1000
thermo_style    custom step v_strain temp v_p2 v_p3 v_p4 ke pe press

run      30000

######################################
# SIMULATION DONE
print "All done"

################################FINISH###########################################


